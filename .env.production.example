# ═══════════════════════════════════════════
# PlexusMap — Production Environment Variables
# Copy to .env.production and fill in real values
# ═══════════════════════════════════════════

# ── Database (uses docker compose service name) ──
DATABASE_URL="postgresql://plexusmap:CHANGE_ME_STRONG_PASSWORD@postgres:5432/plexusmap?schema=public"
POSTGRES_USER=plexusmap
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=plexusmap

# ── NextAuth ──
NEXTAUTH_SECRET="GENERATE_WITH: openssl rand -base64 32"
NEXTAUTH_URL="https://plexusmap.com"

# ── Public URLs (baked into build) ──
NEXT_PUBLIC_SITE_URL="https://plexusmap.com"

# ── Google Maps (optional — fallback works without it) ──
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ── Kairos — Appointment scheduling (optional — uses mock if not set) ──
# KAIROS_API_URL="https://api.kairos.com"
# KAIROS_API_KEY="your-kairos-api-key"

# ── Redis (future cache) ──
REDIS_URL="redis://redis:6379"

# ── Seed mode (only used when running prisma seed) ──
SEED_MODE="production"
# Seed admin/founder credentials (issue #19) — REQUIRED in production/google-places.
# The seed ABORTS if these are missing in prod, to avoid creating default trivial creds.
# Use strong values; never commit the real ones.
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
FOUNDER_PASSWORD="CHANGE_ME_STRONG_FOUNDER_PASSWORD"

# ── Email (future — password reset, notifications) ──
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="noreply@plexusmap.com"
# SMTP_PASS="your-smtp-password"
# EMAIL_FROM="PlexusMap <noreply@plexusmap.com>"
