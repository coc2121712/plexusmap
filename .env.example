# Database — PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/plexusmap?schema=public"

# NextAuth — Authentication
NEXTAUTH_SECRET="generate-a-strong-secret-here"
NEXTAUTH_URL="http://localhost:3001"

# Google Maps (optional — map shows fallback without it)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Kairos — Appointment scheduling (optional — uses mock if not set)
# KAIROS_API_URL="https://api.kairos.com"
# KAIROS_API_KEY="your-kairos-api-key"

# Site URL (used in sitemap, SEO, JSON-LD)
# NEXT_PUBLIC_SITE_URL="https://plexusmap.com"
